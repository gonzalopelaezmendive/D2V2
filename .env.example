PORT=3000

# Anthropic API Key para Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (opcional, si se usa)
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database
# Para desarrollo local con Docker:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/d2v2_db?schema=public"
#
# Para producción con Neon (recomendado para Vercel):
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://postgres:password@localhost:5432/d2v2_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/d2v2_db?schema=public"

# OAuth Configuration
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft OAuth (https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Apple OAuth (https://developer.apple.com/)
APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY=your_apple_private_key_here

# Session & JWT
SESSION_SECRET=your_random_session_secret_here
JWT_SECRET=your_random_jwt_secret_here

# Callback URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5178
